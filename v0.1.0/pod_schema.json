{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aic.compfest.id/v0.1.0/pod_schema.json",
  "title": "PODDocument",
  "description": "Structured extraction schema for Proof of Delivery (POD) documents with signature and stamp presence detection.",
  "type": "object",
  "required": [
    "document_id",
    "pod_number",
    "shipment_id",
    "delivery_status",
    "delivery_date",
    "signature_present"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Internal document asset UUID."
    },
    "pod_number": {
      "type": "string",
      "description": "Reference number printed on the POD."
    },
    "shipment_id": {
      "type": "string",
      "description": "Shipment reference or tracking number."
    },
    "awb_number": {
      "type": "string",
      "description": "Air Waybill / Consignment Note number."
    },
    "delivery_status": {
      "type": "string",
      "enum": ["DELIVERED", "PARTIALLY_DELIVERED", "FAILED", "RETURNED"],
      "description": "Final physical delivery status."
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Date shipment was delivered (YYYY-MM-DD)."
    },
    "delivery_time": {
      "type": "string",
      "description": "Time of delivery (e.g. 14:30)."
    },
    "receiver_name": {
      "type": "string",
      "description": "Name of the person who accepted the delivery."
    },
    "receiver_company": {
      "type": "string",
      "description": "Company or department of recipient."
    },
    "quantity_received": {
      "type": "integer",
      "minimum": 0,
      "description": "Quantity of packages received."
    },
    "condition": {
      "type": "string",
      "enum": ["GOOD", "DAMAGED", "LEAKAGE", "SHORTAGE", "UNKNOWN"],
      "default": "GOOD",
      "description": "Physical cargo condition recorded upon delivery."
    },
    "signature_present": {
      "type": "boolean",
      "description": "Whether a wet signature was detected in the designated signature box/ROI."
    },
    "signature_bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "Coordinates [x1, y1, x2, y2] of the detected signature ROI."
    },
    "signature_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score of the signature presence detection model."
    },
    "stamp_present": {
      "type": "boolean",
      "description": "Whether an official company stamp/seal was detected."
    },
    "stamp_bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "Coordinates [x1, y1, x2, y2] of the detected stamp ROI."
    },
    "remarks": {
      "type": "string",
      "description": "Any handwritten or printed delivery notes."
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common/evidence.json"
      },
      "description": "Traceable bounding box evidence for each extracted field."
    }
  },
  "additionalProperties": false
}
