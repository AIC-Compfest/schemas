{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aic.compfest.id/v0.1.0/rate_agreement_schema.json",
  "title": "RateAgreementDocument",
  "description": "Schema for logistics contract rate cards compiled into machine-executable deterministic pricing rules.",
  "type": "object",
  "required": [
    "document_id",
    "agreement_id",
    "vendor_id",
    "vendor_name",
    "effective_from",
    "effective_to",
    "rate_rules",
    "dispute_window_days"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Internal document asset UUID."
    },
    "agreement_id": {
      "type": "string",
      "description": "Contract agreement ID (e.g. AGR-3PL-2026-001)."
    },
    "vendor_id": {
      "type": "string",
      "description": "Logistics provider identifier."
    },
    "vendor_name": {
      "type": "string",
      "description": "Logistics provider legal/commercial name."
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "description": "Start of contract validity (YYYY-MM-DD)."
    },
    "effective_to": {
      "type": "string",
      "format": "date",
      "description": "End of contract validity (YYYY-MM-DD)."
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "rate_rules": {
      "type": "array",
      "minItems": 1,
      "description": "Matrix of origin-destination routes, service levels, weight tiers, and base rates.",
      "items": {
        "type": "object",
        "required": [
          "origin_zone",
          "destination_zone",
          "service_type",
          "weight_min_kg",
          "weight_max_kg",
          "base_rate"
        ],
        "properties": {
          "origin_zone": {
            "type": "string",
            "description": "Origin city or regional zone (e.g. JAKARTA, JABODETABEK)."
          },
          "destination_zone": {
            "type": "string",
            "description": "Destination city or regional zone (e.g. BANDUNG, SURABAYA)."
          },
          "service_type": {
            "type": "string",
            "description": "e.g. REGULAR, EXPRESS, TRUCKING, SAME_DAY."
          },
          "weight_min_kg": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum weight threshold for this tier (inclusive)."
          },
          "weight_max_kg": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum weight threshold for this tier (inclusive)."
          },
          "base_rate": {
            "type": "number",
            "minimum": 0,
            "description": "Base rate in IDR per shipment or per kg."
          },
          "rate_unit": {
            "type": "string",
            "enum": ["FLAT_PER_SHIPMENT", "PER_KG", "PER_CBM"],
            "default": "FLAT_PER_SHIPMENT"
          },
          "sla_days": {
            "type": "integer",
            "minimum": 1,
            "description": "Agreed transit time SLA in calendar/working days."
          }
        },
        "additionalProperties": false
      }
    },
    "surcharge_rules": {
      "type": "array",
      "description": "Rules for calculating fuel surcharge, insurance, packing, and accessorial fees.",
      "items": {
        "type": "object",
        "required": ["type", "calculation_method", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["FUEL", "INSURANCE", "HANDLING", "PACKING", "REMOTE_AREA", "WEEKEND_DELIVERY"]
          },
          "calculation_method": {
            "type": "string",
            "enum": ["PERCENTAGE_OF_BASE", "PERCENTAGE_OF_CARGO_VALUE", "FLAT_AMOUNT", "PER_KG"]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "description": "Numeric multiplier or percentage (e.g. 14 for 14% fuel surcharge, or 50000 for flat fee)."
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "minimum_charge": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Minimum floor charge per shipment in IDR."
    },
    "tax_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 11,
      "description": "Standard VAT/PPN tax rate in percent (e.g. 11 for 11%)."
    },
    "dispute_window_days": {
      "type": "integer",
      "minimum": 1,
      "default": 30,
      "description": "Allowable dispute submission timeframe in days from invoice date (PRD §9)."
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common/evidence.json"
      }
    }
  },
  "additionalProperties": false
}
